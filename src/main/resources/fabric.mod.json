{
  "schemaVersion": 1,
  "id": "durable_sponges",
  "version": "${version}",
  "name": "Durable Sponges",
  "description": "Makes sponges absorb water for a small amount of time. Making draining areas less frustrating",
  "authors": ["Bristn"],
  "contact": {
    "sources": "https://github.com/Bristn/minecraft-durable-sponges"
  },
  "license": "CC0-1.0",
  "icon": "assets/durable_sponges/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.bristn.durable_sponges.CommonModInitializer"],
    "client": ["net.bristn.durable_sponges.client.DurableSpongesClient"],
    "fabric-datagen": ["net.bristn.durable_sponges.CommonModDataGenerator"]
  },
  "mixins": [
    "durable_sponges.mixins.json",
    {
      "config": "durable_sponges.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~26.2-",
    "java": ">=25",
    "fabric-api": "*"
  }
}
